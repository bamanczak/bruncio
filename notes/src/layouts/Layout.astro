---
import { Image } from 'astro:assets';
import Icon from '../components/Icon.astro';
import head from '../images/header_head.png';

interface Props {
	title?: string;
	description?: string;
}
const { title, description = 'Notes, essays and half-finished thoughts by Bruno.' } = Astro.props;
const pageTitle = title ? `${title} · notes from Bruno` : 'notes from Bruno';

// Hand-placed, slightly off-grid, like a real desktop that's been used for a while.
const desktop = [
	{ icon: 'article-multiple', label: 'notes', href: '/', x: 27, y: 72 },
	{ icon: 'search', label: 'search', href: '/#q', x: 21, y: 174 },
	{ icon: 'user', label: 'about me', href: 'https://frombruno.com/#about', x: 31, y: 268 },
	{ icon: 'image-gallery', label: 'frombruno.com', href: 'https://frombruno.com', x: 18, y: 371 },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" href="/fonts/PixChicago.woff" as="font" type="font/woff" crossorigin />
		<link rel="preload" href="/fonts/atkinson-regular.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline>
			// Before paint, so a saved choice never flashes the other theme.
			try {
				const t = localStorage.getItem('theme');
				if (t) document.documentElement.dataset.theme = t;
			} catch (e) {}
		</script>
	</head>
	<body>
		<header class="bar">
			<a href="/" class="masthead pix">
				<span class="peek"><Image src={head} alt="" width={44} densities={[1, 2]} class="head" /></span>
				notes from <span class="name">Bruno</span>
			</a>
			<div class="theme pix" role="group" aria-label="Theme">
				<button type="button" data-theme="light">light</button>
				<button type="button" data-theme="dark">dark</button>
			</div>
		</header>

		<nav class="desktop" aria-label="Desktop">
			{
				desktop.map((d) => (
					<a href={d.href} class="desktop-icon" style={`left:${d.x}px;top:${d.y}px`}>
						<Icon name={d.icon} size={36} />
						<span class="pix">{d.label}</span>
					</a>
				))
			}
		</nav>

		<main>
			<slot />
		</main>

		<script>
			const root = document.documentElement;
			const buttons = document.querySelectorAll<HTMLButtonElement>('.theme button');
			const current = () => root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
			const mark = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.theme === current())));
			buttons.forEach((b) =>
				b.addEventListener('click', () => {
					root.dataset.theme = b.dataset.theme;
					try {
						localStorage.setItem('theme', b.dataset.theme!);
					} catch (e) {}
					mark();
				}),
			);
			matchMedia('(prefers-color-scheme: dark)').addEventListener('change', mark);
			mark();
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'PixChicago';
		src: url('/fonts/PixChicago.woff') format('woff');
		font-display: swap;
	}
	@font-face {
		font-family: 'Atkinson';
		src: url('/fonts/atkinson-regular.woff2') format('woff2');
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: 'Atkinson';
		src: url('/fonts/atkinson-bold.woff') format('woff');
		font-weight: 700;
		font-display: swap;
	}

	/* Black and white like frombruno.com; yellow is only ever a highlight. */
	:root {
		--paper: #fff;
		--panel: #fff;
		--field: #fff;
		--ink: #111;
		--muted: #737373;
		--rule: #111;
		--soft: #ebebeb;
		--accent: #111;
		--yellow: #ecb337;
		color-scheme: light;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) {
			--paper: #0b0b0b;
			--panel: #111;
			--field: #151515;
			--ink: #f2f2f2;
			--muted: #9a9a9a;
			--rule: #f2f2f2;
			--soft: #262626;
			--accent: #f2f2f2;
			color-scheme: dark;
		}
	}
	:root[data-theme='dark'] {
		--paper: #0b0b0b;
		--panel: #111;
		--field: #151515;
		--ink: #f2f2f2;
		--muted: #9a9a9a;
		--rule: #f2f2f2;
		--soft: #262626;
		--accent: #f2f2f2;
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Atkinson', system-ui, sans-serif;
		font-size: 18px;
		line-height: 1.65;
		overflow-wrap: break-word;
	}
	.pix {
		font-family: 'PixChicago', ui-monospace, monospace;
		font-weight: normal;
		letter-spacing: 0;
	}
	a {
		color: inherit;
		text-decoration-color: var(--yellow);
		text-underline-offset: 3px;
	}
	:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 2px;
	}
	img {
		max-width: 100%;
		height: auto;
	}

	.bar {
		position: sticky;
		top: 0;
		z-index: 5;
		display: flex;
		align-items: center;
		height: 52px;
		padding: 0 16px;
		background: var(--paper);
		border-bottom: 4px solid var(--rule);
	}
	.masthead {
		display: flex;
		align-items: center;
		align-self: stretch;
		color: var(--ink);
		text-decoration: none;
		font-size: 16px;
	}
	/* The head from brunc.io: peeks over the bar's bottom edge, pops up on hover,
	   and wobbles for a second every minute (first time 20s in). */
	.peek {
		align-self: flex-end;
		height: 48px;
		width: 44px;
		margin-right: 4px;
		overflow: hidden;
	}
	.head {
		display: block;
		position: relative;
		top: 18px;
		transition: top 0.25s ease-in-out;
	}
	.masthead:hover .head,
	.masthead:focus-visible .head {
		top: 5px;
	}
	@media (prefers-reduced-motion: no-preference) {
		.head {
			animation: wobble 61s 20s infinite;
		}
	}
	/* animate.css "wobble" squeezed into the first second of a 61s cycle */
	@keyframes wobble {
		0.25% {
			transform: translateX(-25%) rotate(-5deg);
		}
		0.49% {
			transform: translateX(20%) rotate(3deg);
		}
		0.74% {
			transform: translateX(-15%) rotate(-3deg);
		}
		0.98% {
			transform: translateX(10%) rotate(2deg);
		}
		1.23% {
			transform: translateX(-5%) rotate(-1deg);
		}
		1.64%,
		100% {
			transform: none;
		}
	}
	.theme {
		display: flex;
		margin-left: auto;
		border: 2px solid var(--rule);
	}
	.theme button {
		font: inherit;
		font-size: 13px;
		padding: 3px 10px;
		background: var(--field);
		color: var(--ink);
		border: 0;
		border-radius: 0;
		cursor: pointer;
	}
	.theme button + button {
		border-left: 2px solid var(--rule);
	}
	.theme button[aria-pressed='true'] {
		background: var(--ink);
		color: var(--paper);
	}
	.masthead .name {
		background: var(--ink);
		color: var(--paper);
		padding: 2px 6px;
		margin-left: 4px;
	}

	main {
		max-width: 1000px;
		margin: 32px auto 64px;
		padding: 0 16px;
	}

	/* Window chrome, lifted from the pixel preview maker */
	.window {
		border: 4px solid var(--rule);
		background: var(--panel);
		box-shadow: 8px 8px 0 var(--rule);
	}
	.titlebar {
		display: flex;
		justify-content: space-between;
		gap: 10px;
		padding: 6px 10px;
		border-bottom: 4px solid var(--rule);
		background: repeating-linear-gradient(0deg, var(--rule) 0 2px, transparent 2px 5px);
		font-size: 14px;
	}
	.titlebar span {
		background: var(--panel);
		padding: 0 8px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	@media (max-width: 600px) {
		.window {
			box-shadow: 5px 5px 0 var(--rule);
		}
	}

	.desktop {
		display: none;
	}
	/* The window is 1000px wide; below this the icons would sit under it. */
	@media (min-width: 1360px) {
		.desktop {
			display: block;
		}
	}
	.desktop-icon {
		position: fixed;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		width: 140px;
		padding: 6px 4px;
		color: var(--ink);
		text-decoration: none;
		border: 2px solid transparent;
	}
	.desktop-icon span {
		font-size: 11px;
		white-space: nowrap;
		background: var(--paper);
		padding: 0 4px;
	}
	.desktop-icon:hover,
	.desktop-icon:focus-visible {
		border-color: var(--rule);
	}
	.desktop-icon:hover span,
	.desktop-icon:focus-visible span {
		background: var(--ink);
		color: var(--paper);
	}

	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
</style>
